object FormAISettings: TFormAISettings
  Left = 340
  Height = 600
  Top = 130
  Width = 620
  BorderStyle = bsDialog
  Caption = 'Pengaturan Layanan Kecerdasan Buatan (AI Engine)'
  ClientHeight = 600
  ClientWidth = 620
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  OnShow = FormShow
  object pnlTop: TPanel
    Left = 0
    Height = 55
    Top = 0
    Width = 620
    Align = alTop
    BevelOuter = bvNone
