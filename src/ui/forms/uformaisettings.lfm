      Font.Style = [fsBold]
      ParentColor = False
      ParentFont = False
    end
    object lblHeaderSubtitle: TLabel
      Left = 16
      Height = 13
      Top = 32
      Width = 451
      Caption = 'Pilih antara Google Gemini Cloud (Online) atau server lokal llama.cpp (Offline/In-House)'
      Font.Color = clGrayText
      Font.Height = -11
      ParentColor = False
      ParentFont = False
    end
  end
  object gbProvider: TGroupBox
    Left = 16
    Height = 55
    Top = 64
    Width = 588
