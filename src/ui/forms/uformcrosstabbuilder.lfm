    ClientWidth = 540
    Color = clMenuBar
    ParentColor = False
    TabOrder = 0
    object lblTitle: TLabel
      Left = 16
      Height = 18
      Top = 10
      Width = 285
      Caption = '📊 Perancang Crosstab (Pivot Table) Query'
      Font.Height = -15
      Font.Style = [fsBold]
      ParentColor = False
      ParentFont = False
    end
    object lblSubtitle: TLabel
      Left = 16
      Height = 14
      Top = 32
      Width = 470
      Caption = 'Hasilkan matriks 2D (Pivot) data baris x kolom seperti pada fitur Crosstab Microsoft Access'
      Font.Color = clGrayText
      Font.Height = -11
      ParentColor = False
      ParentFont = False
    end
  end
