object FormCrosstabBuilder: TFormCrosstabBuilder
  Left = 320
  Height = 440
  Top = 150
  Width = 540
  BorderStyle = bsDialog
  Caption = 'Crosstab (Pivot Table) Query Wizard'
  ClientHeight = 440
  ClientWidth = 540
  Position = poScreenCenter
  OnShow = FormShow
  object pnlTop: TPanel
    Left = 0
    Height = 60
    Top = 0
    Width = 540
    Align = alTop
    BevelOuter = bvNone
