object FormDataTransfer: TFormDataTransfer
  Left = 270
  Height = 620
  Top = 110
  Width = 860
  Caption = 'Cross-DBMS Direct Data Transfer & Migration'
  ClientHeight = 620
  ClientWidth = 860
  Position = poScreenCenter
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnShow = FormShow
  object pnlTop: TPanel
    Left = 0
    Height = 55
    Top = 0
    Width = 860
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 55
    ClientWidth = 860
    Color = clMenuBar
    ParentBackground = False
    ParentColor = False
    TabOrder = 0
    object lblHeaderTitle: TLabel
      Left = 16
      Height = 18
      Top = 10
      Width = 320
      Caption = '🚀 Cross-DBMS Direct Data Transfer'
      Font.Height = -15
      Font.Style = [fsBold]
      ParentColor = False
      ParentFont = False
    end
    object lblHeaderSubtitle: TLabel
      Left = 16
      Height = 14
      Top = 32
      Width = 475
      Caption = 'Streaming skema struktur dan baris data langsung antar database berbeda secara on-the-fly'
      Font.Color = clGrayText
      Font.Height = -11
      ParentColor = False
      ParentFont = False
    end
  end
  object pnlMain: TPanel
    Left = 0
    Height = 505
    Top = 55
    Width = 860
    Align = alClient
    BevelOuter = bvNone
    ClientHeight = 505
    ClientWidth = 860
    TabOrder = 1
    object gbSource: TGroupBox
      Left = 16
      Height = 310
      Top = 8
      Width = 400
      Caption = ' Sumber (Source Database) '
      ClientHeight = 290
      ClientWidth = 396
      Font.Style = [fsBold]
      ParentFont = False
      TabOrder = 0
      object lblSourceConn: TLabel
        Left = 12
        Height = 15
        Top = 8
        Width = 100
        Caption = 'Koneksi Sumber:'
        ParentColor = False
        ParentFont = False
      end
      object cboSourceConn: TComboBox
        Left = 12
        Height = 23
        Top = 26
        Width = 372
        ItemHeight = 15
        Style = csDropDownList
        TabOrder = 0
        OnChange = cboSourceConnChange
      end
      object lblSourceTables: TLabel
        Left = 12
        Height = 15
        Top = 58
        Width = 125
        Caption = 'Pilih Tabel yang Disalin:'
        ParentColor = False
        ParentFont = False
      end
      object btnSelectAllTables: TSpeedButton
        Left = 240
        Height = 20
        Top = 54
        Width = 70
        Caption = 'Pilih Semua'
        ParentFont = False
        OnClick = btnSelectAllTablesClick
      end
      object btnUnselectAllTables: TSpeedButton
        Left = 315
        Height = 20
        Top = 54
        Width = 70
        Caption = 'Hapus Pilihan'
        ParentFont = False
        OnClick = btnUnselectAllTablesClick
      end
      object clbSourceTables: TCheckListBox
        Left = 12
        Height = 206
        Top = 76
        Width = 372
        ItemHeight = 0
        ParentFont = False
        TabOrder = 1
      end
    end
    object gbTarget: TGroupBox
      Left = 428
      Height = 85
      Top = 8
      Width = 416
      Caption = ' Tujuan (Target Database) '
      ClientHeight = 65
      ClientWidth = 412
      Font.Style = [fsBold]
      ParentFont = False
      TabOrder = 1
      object lblTargetConn: TLabel
        Left = 12
        Height = 15
        Top = 10
        Width = 90
        Caption = 'Koneksi Tujuan:'
        ParentColor = False
        ParentFont = False
      end
      object cboTargetConn: TComboBox
        Left = 12
        Height = 23
        Top = 28
        Width = 388
        ItemHeight = 15
        Style = csDropDownList
        TabOrder = 0
      end
    end
    object gbOptions: TGroupBox
      Left = 428
      Height = 215
      Top = 103
      Width = 416
      Caption = ' Opsi Transfer & Pipeline '
      ClientHeight = 195
      ClientWidth = 412
      Font.Style = [fsBold]
      ParentFont = False
      TabOrder = 2
      object chkCreateTable: TCheckBox
        Left = 16
        Height = 19
        Top = 10
        Width = 270
        Caption = 'Buat tabel di target jika belum ada (Auto-DDL)'
        Checked = True
        ParentFont = False
        State = cbChecked
        TabOrder = 0
      end
      object chkTruncateTable: TCheckBox
        Left = 16
        Height = 19
        Top = 38
        Width = 265
        Caption = 'Kosongkan tabel target sebelum transfer data'
        ParentFont = False
        TabOrder = 1
      end
      object chkTransferData: TCheckBox
        Left = 16
        Height = 19
        Top = 66
        Width = 220
        Caption = 'Salin seluruh baris data (Records)'
        Checked = True
        ParentFont = False
        State = cbChecked
        TabOrder = 2
      end
      object chkContinueOnError: TCheckBox
        Left = 16
        Height = 19
        Top = 94
        Width = 270
        Caption = 'Lanjutkan transfer jika terjadi error pada tabel'
        ParentFont = False
        TabOrder = 3
      end
      object lblBatchSize: TLabel
        Left = 16
        Height = 15
        Top = 135
        Width = 145
        Caption = 'Ukuran Batch Commit Baris:'
        ParentColor = False
        ParentFont = False
      end
      object seBatchSize: TSpinEdit
        Left = 175
        Height = 23
        Top = 130
        Width = 90
        Increment = 100
        MaxValue = 50000
        MinValue = 50
        TabOrder = 4
        Value = 500
      end
    end
    object pnlProgress: TPanel
      Left = 16
      Height = 175
      Top = 325
      Width = 828
      Anchors = [akTop, akLeft, akRight, akBottom]
      BevelOuter = bvNone
      ClientHeight = 175
      ClientWidth = 828
      TabOrder = 3
      object lblCurrentStatus: TLabel
        Left = 0
        Height = 15
        Top = 2
        Width = 120
        Caption = 'Status: Menunggu aksi...'
