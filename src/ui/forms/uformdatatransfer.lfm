        ParentColor = False
        ParentFont = False
      end
      object prgTable: TProgressBar
        Left = 0
        Height = 6
        Top = 22
        Width = 828
        Anchors = [akTop, akLeft, akRight]
        TabOrder = 0
        Visible = False
      end
      object memTransferLog: TMemo
        Left = 0
        Height = 140
        Top = 34
        Width = 828
        Align = alBottom
        Anchors = [akTop, akLeft, akRight, akBottom]
        Color = 16514043
        Font.Height = -12
        Font.Name = 'Courier New'
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoVertical
        TabOrder = 1
      end
    end
  end
  object pnlBottom: TPanel
    Left = 0
    Height = 60
