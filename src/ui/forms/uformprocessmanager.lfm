object FormProcessManager: TFormProcessManager
  Left = 320
  Height = 600
  Top = 160
  Width = 900
  Caption = 'Process List & Session Manager'
  ClientHeight = 600
  ClientWidth = 900
  Position = poScreenCenter
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnShow = FormShow
  object pnlToolbar: TPanel
    Left = 0
    Height = 40
    Top = 0
    Width = 900
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 40
    ClientWidth = 900
    TabOrder = 0
    object btnRefresh: TSpeedButton
      Left = 8
      Height = 28
      Top = 6
      Width = 80
      Caption = 'Segarkan'
      OnClick = btnRefreshClick
    end
    object sepTool1: TBevel
      Left = 96
      Height = 26
      Top = 7
      Width = 2
      Shape = bsLeftLine
    end
    object btnCancelQuery: TSpeedButton
      Left = 106
      Height = 28
      Top = 6
      Width = 110
      Caption = 'Batalkan Query'
      OnClick = btnCancelQueryClick
    end
    object btnKillSession: TSpeedButton
      Left = 222
      Height = 28
      Top = 6
      Width = 100
      Caption = 'Kill Sesi'
      OnClick = btnKillSessionClick
    end
    object chkAutoRefresh: TCheckBox
      Left = 340
      Height = 19
      Top = 11
      Width = 90
      Caption = 'Auto Refresh'
      OnChange = chkAutoRefreshChange
      TabOrder = 0
    end
    object lblInterval: TLabel
      Left = 436
      Height = 15
      Top = 13
      Width = 24
      Caption = 'Setiap:'
      ParentColor = False
    end
    object cboInterval: TComboBox
      Left = 466
      Height = 23
      Top = 8
      Width = 70
      ItemHeight = 15
      ItemIndex = 1
      Items.Strings = (
        '1 dtk'
        '3 dtk'
        '5 dtk'
        '10 dtk'
      )
      OnChange = cboIntervalChange
      Style = csDropDownList
      TabOrder = 1
      Text = '3 dtk'
    end
    object lblSearch: TLabel
      Left = 560
      Height = 15
      Top = 13
      Width = 32
      Caption = 'Filter:'
      ParentColor = False
    end
    object edtSearch: TEdit
      Left = 598
      Height = 23
      Top = 8
      Width = 290
      Anchors = [akTop, akLeft, akRight]
      OnChange = edtSearchChange
      TabOrder = 2
      TextHint = 'Cari PID, user, query...'
    end
  end
  object lvProcesses: TListView
    Left = 0
    Height = 370
    Top = 40
    Width = 900
    Align = alClient
    Columns = <
      item
        Caption = 'PID / ID'
        Width = 75
      end
      item
        Caption = 'User'
        Width = 90
      end
      item
        Caption = 'Database'
        Width = 100
      end
      item
        Caption = 'Host / Client'
        Width = 130
      end
      item
        Caption = 'Durasi (detik)'
        Width = 90
      end
      item
        Caption = 'Status / State'
        Width = 100
      end
      item
        Caption = 'Query'
        Width = 300
      end>
    GridLines = True
    ReadOnly = True
    RowSelect = True
    TabOrder = 1
    ViewStyle = vsReport
    OnSelectItem = lvProcessesSelectItem
  end
  object splBottom: TSplitter
    Cursor = crVSplit
    Left = 0
    Height = 5
    Top = 410
    Width = 900
    Align = alBottom
    ResizeAnchor = akBottom
  end
  object pnlBottomQuery: TPanel
    Left = 0
    Height = 185
    Top = 415
    Width = 900
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 185
    ClientWidth = 900
    TabOrder = 2
    object pnlQueryHeader: TPanel
      Left = 0
      Height = 26
      Top = 0
      Width = 900
      Align = alTop
      BevelOuter = bvNone
      ClientHeight = 26
      ClientWidth = 900
      Color = clMenuBar
      ParentColor = False
      TabOrder = 0
      object lblQueryTitle: TLabel
        Left = 8
        Height = 15
        Top = 5
        Width = 86
        Caption = 'Query Lengkap:'
        Font.Style = [fsBold]
        ParentColor = False
        ParentFont = False
      end
    end
    object synQuery: TSynEdit
      Left = 0
      Height = 159
      Top = 26
      Width = 900
      Align = alClient
      Font.Height = -13
      Font.Name = 'Courier New'
      Font.Pitch = fpFixed
      Font.Quality = fqCleartype
      ParentColor = False
      ParentFont = False
      TabOrder = 1
      Gutter.Width = 30
      RightGutter.Width = 0
      Highlighter = synSQLSyn
    end
  end
  object synSQLSyn: TSynSQLSyn
    DefaultFilter = 'SQL Files (*.sql)|*.sql'
    Enabled = True
    Left = 780
    Top = 480
  end
  object tmrRefresh: TTimer
    Enabled = False
    Interval = 3000
    OnTimer = tmrRefreshTimer
    Left = 700
    Top = 480
  end
end
