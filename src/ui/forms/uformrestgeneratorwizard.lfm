        OnChange = chkEnableAuthChange
      end
      object lblApiKey: TLabel
        Left = 24
        Height = 15
        Top = 142
        Width = 86
        Caption = 'Secret API Key:'
        Font.Style = [fsBold]
        ParentColor = False
        ParentFont = False
      end
      object edtApiKey: TEdit
        Left = 160
        Height = 23
        Top = 138
        Width = 320
        TabOrder = 3
        Text = 'siadmin-secret-api-key-2026'
      end
      object lblOutDir: TLabel
        Left = 24
        Height = 15
        Top = 185
        Width = 106
        Caption = 'Direktori Keluaran:'
        Font.Style = [fsBold]
        ParentColor = False
        ParentFont = False
      end
      object edtOutDir: TEdit
        Left = 160
        Height = 23
        Top = 182
        Width = 400
        TabOrder = 4
